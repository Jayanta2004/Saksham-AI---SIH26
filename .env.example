# ==============================================================================
# SAKSHAM AI - PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Ministry of Statistics & Programme Implementation (MoSPI)
# ==============================================================================
# This template aggregates all environment variables required across the 3 microservices:
# 1. backend/gateway_service/.env
# 2. backend/ai_service/.env
# 3. frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND GATEWAY SERVICE (Node.js Express - Port 5000)
# File Path: backend/gateway_service/.env
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JWT & Data Encryption Security Keys
JWT_SECRET=saksham_super_secret_jwt_key_sih_2026_mospi
DATA_ENCRYPTION_KEY=saksham_ai_mospi_secure_key_2026_32char!!

# Python AI Service Connection
PYTHON_AI_URL=http://127.0.0.1:8000

# PostgreSQL Database (Neon Serverless PostgreSQL or Local Postgres)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require

# Redis Cache (Upstash Redis or Local Redis)
REDIS_URL=rediss://default:token@sample.upstash.io:6379

# --- EMAIL NOTIFICATION CONFIGURATION (CHOOSE ONE OPTION) ---

# Option A: Gmail SMTP (Recommended for Local Development & Paid VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_16_char_app_password
SMTP_FROM="Saksham AI - MoSPI" <your_gmail_address@gmail.com>

# Option B: Brevo API (RECOMMENDED for Render Free Tier - Sends to ANY email globally)
# Get a free API key at https://brevo.com (300 emails/day free, no custom domain required)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_FROM_EMAIL=your_registered_email@gmail.com


# ------------------------------------------------------------------------------
# 2. PYTHON AI SERVICE (FastAPI - Port 8000)
# File Path: backend/ai_service/.env
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# AI Foundation Models (RAG, Competency Gap, Dynamic Quizzes, Semantic Search)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here


# ------------------------------------------------------------------------------
# 3. FRONTEND PORTAL (React / Vite - Port 3000 or 5173)
# File Path: frontend/.env
# ------------------------------------------------------------------------------
# Point this to your Gateway Service URL (Localhost or live deployed cloud URL)
VITE_API_URL=http://localhost:5000
